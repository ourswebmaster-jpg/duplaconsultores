# Envio do formulário "Fale connosco" (Resend — https://resend.com).
# Sem RESEND_API_KEY o formulário responde com erro e pede para usar o email.
RESEND_API_KEY=
# Remetente: tem de ser de um domínio verificado no Resend.
CONTACT_FROM="Site Dupla <site@duplaconsultores.pt>"
# Para onde vão as mensagens.
CONTACT_TO=geral@duplaconsultores.pt
